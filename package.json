{
  "name": "magic-reverse-proxy",
  "version": "4.0.0",
  "description": "HTTP/HTTPS reverse proxy with a fluent TypeScript API, virtual hosts, WebSocket support, pluggable Round-Robin balancing, and HSTS policy helpers.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "lint": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MurylloEx/Magic-Proxy.git"
  },
  "keywords": [
    "proxy",
    "reverse-proxy",
    "websocket",
    "round-robin",
    "vhost",
    "hsts",
    "load-balancer",
    "typescript"
  ],
  "author": "Muryllo Pimenta de Oliveira",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/MurylloEx/Magic-Proxy/issues"
  },
  "homepage": "https://github.com/MurylloEx/Magic-Proxy#readme",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "express": "^5.1.0",
    "http-proxy": "^1.18.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/http-proxy": "^1.17.16",
    "@types/node": "^22.15.30",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
